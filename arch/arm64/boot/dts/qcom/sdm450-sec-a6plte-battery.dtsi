	sm5708-charger {
		status = "disable";
		compatible = "samsung,sm5708-charger";
		battery,chg_gpio_en = <&tlmm 34 0x00>;
		battery,chg_polarity_en = <0x00>;
		battery,chg_gpio_status = <0x00>;
		battery,chg_polarity_status = <0x00>;
		battery,chg_float_voltage = <0x10fe>;
	};
	mux_sel {
		compatible = "samsung,sec-mux-sel";
		mux_sel,mux_sel_1_en = <0x01>;
		mux_sel,mux_sel_1 = <&pm8953_gpios 7 0x00>;
		mux_sel,mux_sel_1_type = <0x14>;
		mux_sel,mux_sel_1_mpp = <0x04>;
		mux_sel,mux_sel_1_low = <0x04>;
		mux_sel,mux_sel_1_high = <0x02>;
	};
	battery_params {
		battery,id = <0x00>;
		battery0,battery_type = <0x10fe>;
		battery0,battery_table0 = <0x1400 0x1b33 0x1ccd 0x1d6b 0x1d97 0x1ddb 0x1e28 0x1e75 0x1ecd 0x1f62 0x1fa8 0x1fd3 0x2064 0x20e9 0x225a 0x2400>;
