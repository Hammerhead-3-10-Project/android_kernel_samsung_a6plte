// Battery, charger, fuel gauge and MUIC of the Samsung A6+ (SM5708 family), ported from the stock DT.

&tlmm {
			sm5708_i2c_pins {
				qcom,num-grp-pins = <0x02>;
				qcom,pin-func = <0x00>;
				label = "sm5708_gpio";

				p1c7: default {

					mux {
						pins = "gpio98", "gpio99";
						function = "gpio";
					};

					config {
						pins = "gpio98", "gpio99";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				p1ca: active {

					mux {
						pins = "gpio98", "gpio99";
						function = "gpio";
					};

					config {
						pins = "gpio98", "gpio99";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				p1cb: suspend {

					mux {
						pins = "gpio98", "gpio99";
						function = "gpio";
					};

					config {
						pins = "gpio98", "gpio99";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
			sm5708_intr_pins {
				qcom,pin-func = <0x00>;
				label = "sm5708_gpio_int";

				p1c8: default {

					mux {
						pins = "gpio63";
						function = "gpio";
					};

					config {
						pins = "gpio63";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				active {

					mux {
						pins = "gpio63";
						function = "gpio";
					};

					config {
						pins = "gpio63";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				suspend {

					mux {
						pins = "gpio63";
						function = "gpio";
					};

					config {
						pins = "gpio63";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
			sm5708_rst_pins {
				label = "sm5708_rst_pin";

				p1c9: default {

					mux {
						pins = "gpio61";
						function = "gpio";
					};

					config {
						pins = "gpio61";
						drive-strength = <0x02>;
						bias-disable;
						input-enable;
					};
				};
			};
			charger_int_pin {
				qcom,num-grp-pins = <0x01>;
				qcom,pin-func = <0x00>;
				label = "charger_int_gpio";

				p1cc: charger_int_active {

					mux {
						pins = "gpio126";
						function = "gpio";
					};

					config {
						pins = "gpio126";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
			chg_en_pin {
				pins = "gpio34";
				qcom,num-grp-pins = <0x01>;
				qcom,pin-func = <0x00>;
				label = "chg_en_gpio";

				p1cd: chg_en_default {

					mux {
						pins = "gpio34";
						function = "gpio";
					};

					config {
						pins = "gpio34";
						drive-strength = <0x02>;
						bias-pull-down;
						output-high;
					};
				};
			};
			fuel_int_pin {
				qcom,num-grp-pins = <0x01>;
				qcom,pin-func = <0x00>;
				label = "fuel_int_gpio";

				p1c2: fuel_int_default {

					mux {
						pins = "gpio62";
						function = "gpio";
					};

					config {
						pins = "gpio62";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				p1c4: fuel_int_active {

					mux {
						pins = "gpio62";
						function = "gpio";
					};

					config {
						pins = "gpio62";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				p1c6: fuel_int_suspend {

					mux {
						pins = "gpio62";
						function = "gpio";
					};

					config {
						pins = "gpio62";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
			fg_i2c {
				qcom,num-grp-pins = <0x02>;
				qcom,pin-func = <0x00>;
				label = "sm5708_fg_gpio";

				p1c1: fg_i2c_default {

					mux {
						pins = "gpio38", "gpio39";
						function = "gpio";
					};

					config {
						pins = "gpio38", "gpio39";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				p1c3: fg_i2c_active {

					mux {
						pins = "gpio38", "gpio39";
						function = "gpio";
					};

					config {
						pins = "gpio38", "gpio39";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				p1c5: fg_i2c_suspend {

					mux {
						pins = "gpio38", "gpio39";
						function = "gpio";
					};

					config {
						pins = "gpio38", "gpio39";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
};

/* sdm450.dtsi drops the MPP4 "case thermistor" nodes; the A6+ battery thermistor sits behind it. */
&pm8953_mpps {
	case_therm {
		cas_therm_default: cas_therm_default {
			pins = "mpp4";
			function = "analog";
			input-enable;
			qcom,amux-route = <3>;
		};
	};
};

&pm8953_vadc {
	pinctrl-0 = <&pa_therm1_default &cas_therm_default>;

	chan@13 {
		label = "mpp4_div1";
		reg = <0x13>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		qcom,vadc-thermal-node;
	};
};

&soc {
		i2c@10 {
			cell-index = <0x0a>;
			compatible = "i2c-gpio";
			gpios = <&tlmm 39 0x00 &tlmm 38 0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sm5708-fuelgauge@71 {
				compatible = "sm5708-fuelgauge,i2c";
				reg = <0x71>;
				pinctrl-names = "default";
				pinctrl-0 = <&p1c1 &p1c2>;
				pinctrl-1 = <&p1c3 &p1c4>;
				pinctrl-2 = <&p1c5 &p1c6>;
				fuelgauge,fuel_int = <&tlmm 62 0x00>;
				fuelgauge,fuel_alert_soc = <0x01>;
				fuelgauge,capacity_max = <0x3e8>;
				fuelgauge,capacity_max_margin = <0x46>;
				fuelgauge,capacity_min = <0x00>;
				fuelgauge,capacity_calculation_type = <0x1f>;
				fuelgauge,type_str = "BATTERY";
				fuelgauge,model_type = <0x01>;
				fuelgauge,fg_log_enable = <0x01>;
			};
		};
		i2c@13 {
			cell-index = <0x0d>;
			compatible = "i2c-gpio";
			gpios = <&tlmm 98 0x00 &tlmm 99 0x00>;
			i2c-gpio,delay-us = <0x02>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			muic-sm5708@25 {
				status = "okay";
				compatible = "muic-universal";
				reg = <0x25>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x3f 0x00>;
				muic-universal,irq-gpio = <&tlmm 63 0x00>;
				sm5708,wakeup;
				muic-universal,chip_name = "sm,sm5708";
				pinctrl-names = "muic_i2c_pins_default", "muic_i2c_pins_active", "muic_i2c_pins_suspend";
				pinctrl-0 = <&p1c7 &p1c8 &p1c9>;
				pinctrl-1 = <&p1ca &p1c8 &p1c9>;
				pinctrl-2 = <&p1cb &p1c8 &p1c9>;
				muic,sm5705_switch_gpio = <&tlmm 45 0x00>;
				muic,max-afc-support-volt = <0x04>;
				muic,max-afc-support-cur = <0x08>;
			};

			sm5708@49 {
				compatible = "sm,sm5708";
				reg = <0x49>;
				interrupt-parent = <&tlmm>;
				sm5708,irq-gpio = <&tlmm 126 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&p1cc &p1cd>;
			};
		};
};

/ {
	battery {
		status = "okay";
		compatible = "samsung,sec-battery";
		battery,vendor = "BATTERY";
		battery,charger_name = "sm5708-charger";
