		battery,temp_table_adc = <0x658d 0x665a 0x674f 0x6882 0x69e1 0x6b81 0x6d82 0x6fbd 0x724f 0x7536 0x785f 0x7c2b 0x7fe7 0x83e7 0x8832 0x8c57 0x906e 0x9421 0x979f 0x9a92 0x9d3f 0x9f76 0xa13a>;
