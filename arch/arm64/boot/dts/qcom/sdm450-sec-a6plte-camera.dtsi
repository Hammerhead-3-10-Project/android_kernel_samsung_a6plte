			pins = "gpio27";
			function = "gpio";
		};
		config {
			pins = "gpio27";
			bias-pull-down;
			drive-strength = <4>;
			output-low;
		};
	};

	a6_cam_rear1_default: a6_cam_rear1_default {
		mux {
			pins = "gpio40";
			function = "gpio";
		};
		config {
			pins = "gpio40";
			bias-pull-down;
			drive-strength = <2>;
			output-low;
		};
	};

