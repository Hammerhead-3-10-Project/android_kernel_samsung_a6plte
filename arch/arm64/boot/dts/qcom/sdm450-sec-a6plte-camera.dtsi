/ {
	a6_led_flash: qcom,camera-flash {
		cell-index = <0>;
		compatible = "qcom,camera-flash";
		qcom,flash-type = <3>;
		qcom,cci-master = <0>;
		qcom,flash-name = "sm5708";
		qcom,flash-operation-type = "mono";
	};
};

&cci {
	a6_camera0: qcom,camera@0 {
		cell-index = <0>;
		compatible = "qcom,camera";
		reg = <0x0>;
		qcom,csiphy-sd-index = <0>;
		qcom,csid-sd-index = <0>;
		qcom,mount-angle = <90>;
		qcom,actuator-src = <&a6_actuator0>;
		qcom,led-flash-src = <&a6_led_flash>;
		qcom,eeprom-src = <&a6_eeprom0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&a6_cam_mclk0_default &a6_cam_rear1_default
				&a6_cam_rear1_vio_default &a6_cam_rear1_vaf_default>;
		pinctrl-1 = <&a6_cam_mclk0_sleep &a6_cam_rear1_sleep
				&a6_cam_rear1_vio_sleep &a6_cam_rear1_vaf_sleep>;
		gpios = <&tlmm 26 0>, <&tlmm 40 0>, <&tlmm 92 0>, <&tlmm 89 0>,
			<&expander 12 0>;
		qcom,gpio-reset = <1>;
		qcom,gpio-vio = <2>;
		qcom,gpio-vaf = <3>;
		qcom,gpio-custom1 = <4>;
		qcom,gpio-req-tbl-num = <0 1 2 3 4>;
		qcom,gpio-req-tbl-flags = <1 0 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK0", "CAM_RESET0", "CAM_VIO",
					  "CAM_VAF", "CAM_CUSTOM1";
		qcom,sensor-position = <0>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <1>;
		status = "ok";
		clocks = <&clock_gcc clk_mclk0_clk_src>,
			 <&clock_gcc clk_gcc_camss_mclk0_clk>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};

	a6_camera1: qcom,camera@1 {
		cell-index = <1>;
		compatible = "qcom,camera";
		reg = <0x1>;
		qcom,csiphy-sd-index = <1>;
		qcom,csid-sd-index = <1>;
		qcom,mount-angle = <270>;
		qcom,led-flash-src = <&a6_led_flash>;
		qcom,eeprom-src = <&a6_eeprom1>;
		cam_vdig-supply = <&pm8953_l23>;
		qcom,cam-vreg-name = "cam_vdig";
		qcom,cam-vreg-type = <0>;
		qcom,cam-vreg-min-voltage = <1050000>;
		qcom,cam-vreg-max-voltage = <1050000>;
		qcom,cam-vreg-op-mode = <1050000>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&a6_cam_mclk1_default &a6_cam_front_default
				&a6_cam_rear2_vio_default>;
		pinctrl-1 = <&a6_cam_mclk1_sleep &a6_cam_front_sleep
				&a6_cam_rear2_vio_sleep>;
		gpios = <&tlmm 27 0>, <&tlmm 129 0>, <&expander 12 0>,
			<&expander 13 0>, <&tlmm 94 0>;
		qcom,gpio-reset = <1>;
		qcom,gpio-vio = <2>;
		qcom,gpio-vana = <3>;
		qcom,gpio-custom1 = <4>;
		qcom,gpio-req-tbl-num = <0 1 2 3 4>;
		qcom,gpio-req-tbl-flags = <1 0 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK1", "CAM_RESET1", "CAM_VIO",
					  "CAM_VANA", "CAM_CUSTOM1";
		qcom,sensor-position = <1>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <0>;
		status = "ok";
		clocks = <&clock_gcc clk_mclk1_clk_src>,
			 <&clock_gcc clk_gcc_camss_mclk1_clk>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};

	a6_camera2: qcom,camera@2 {
		cell-index = <2>;
		compatible = "qcom,camera";
		reg = <0x2>;
		qcom,csiphy-sd-index = <2>;
		qcom,csid-sd-index = <2>;
		qcom,mount-angle = <90>;
		qcom,eeprom-src = <&a6_eeprom2>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&a6_cam_mclk0_default &a6_cam_rear2_default
				&a6_cam_rear2_vio_default>;
		pinctrl-1 = <&a6_cam_mclk0_sleep &a6_cam_rear2_sleep
				&a6_cam_rear2_vio_sleep>;
		gpios = <&tlmm 26 0>, <&tlmm 41 0>, <&tlmm 94 0>,
			<&expander 12 0>;
		qcom,gpio-reset = <1>;
		qcom,gpio-vio = <2>;
		qcom,gpio-custom1 = <3>;
		qcom,gpio-req-tbl-num = <0 1 2 3>;
		qcom,gpio-req-tbl-flags = <1 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK0", "CAM_RESET2", "CAM_VIO",
					  "CAM_CUSTOM1";
		qcom,sensor-position = <0>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <0>;
		status = "ok";
		clocks = <&clock_gcc clk_mclk0_clk_src>,
			 <&clock_gcc clk_gcc_camss_mclk0_clk>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};
};

