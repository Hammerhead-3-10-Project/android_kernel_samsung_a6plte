&cci {
	#address-cells = <1>;
	#size-cells = <0>;

	/* CCI timings of the stock DT (standard mode stays unused) */
}; /* cci */

&i2c_freq_400Khz {
	status = "ok";
	qcom,hw-thigh = <0x14>;
	qcom,hw-tlow = <0x1c>;
	qcom,hw-tsu-sto = <0x15>;
	qcom,hw-tsu-sta = <0x15>;
	qcom,hw-thd-dat = <0x0d>;
	qcom,hw-thd-sta = <0x12>;
	qcom,hw-tbuf = <0x20>;
	qcom,hw-scl-stretch-en = <0x00>;
	qcom,hw-trdhld = <0x06>;
	qcom,hw-tsp = <0x03>;
};

&i2c_freq_custom {
	status = "ok";
	qcom,hw-thigh = <0x0f>;
	qcom,hw-tlow = <0x1c>;
	qcom,hw-tsu-sto = <0x15>;
	qcom,hw-tsu-sta = <0x15>;
	qcom,hw-thd-dat = <0x0d>;
	qcom,hw-thd-sta = <0x12>;
	qcom,hw-tbuf = <0x19>;
	qcom,hw-scl-stretch-en = <0x01>;
	qcom,hw-trdhld = <0x06>;
	qcom,hw-tsp = <0x03>;
};

&i2c_freq_1Mhz {
	status = "ok";
	qcom,hw-thigh = <0x10>;
	qcom,hw-tlow = <0x16>;
	qcom,hw-tsu-sto = <0x11>;
	qcom,hw-tsu-sta = <0x12>;
	qcom,hw-thd-dat = <0x10>;
	qcom,hw-thd-sta = <0x0f>;
	qcom,hw-tbuf = <0x13>;
	qcom,hw-scl-stretch-en = <0x01>;
	qcom,hw-trdhld = <0x03>;
	qcom,hw-tsp = <0x03>;
	qcom,cci-clk-src = <0x23c3460>;
};

