// Camera of the Samsung A6+ (rear S5K2P6SX, front S5K2X7SP, second rear SR556).
// Generated by scripts/gen-a6plte-camera-dtsi.py from the stock device tree.

&tlmm {
	a6_cam_mclk0_default: a6_cam_mclk0_default {
		mux {
			pins = "gpio26";
			function = "cam_mclk";
		};
		config {
			pins = "gpio26";
			bias-disable;
			drive-strength = <4>;
		};
	};

	a6_cam_mclk0_sleep: a6_cam_mclk0_sleep {
		mux {
			pins = "gpio26";
			function = "gpio";
		};
		config {
			pins = "gpio26";
			bias-pull-down;
			drive-strength = <4>;
			output-low;
		};
	};

	a6_cam_mclk1_default: a6_cam_mclk1_default {
		mux {
			pins = "gpio27";
			function = "cam_mclk";
		};
