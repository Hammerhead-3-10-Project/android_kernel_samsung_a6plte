// Accelerometer/gyroscope (LSM6DSL), magnetometer (YAS539) and proximity/light
// sensor (CM36658) of the Samsung A6+, ported from the stock DT.

&tlmm {
	acc_int: acc_int {
		mux {
			pins = "gpio42";
			function = "gpio";
		};
		config {
			pins = "gpio42";
			drive-strength = <2>;
			bias-disable;
		};
	};

	sensor_i2c: sensor_i2c {
		mux {
			pins = "gpio64", "gpio65";
			function = "gpio";
		};
		config {
			pins = "gpio64", "gpio65";
			drive-strength = <2>;
			bias-disable;
		};
	};

	prox_int: prox_int {
		mux {
			pins = "gpio43";
			function = "gpio";
		};
		config {
			pins = "gpio43";
			drive-strength = <2>;
			bias-disable;
		};
	};

	prox_ldo_en: prox_ldo_en {
		mux {
			pins = "gpio127";
			function = "gpio";
		};
		config {
			pins = "gpio127";
			drive-strength = <2>;
			bias-disable;
		};
	};

	prox_i2c: prox_i2c {
		mux {
			pins = "gpio16", "gpio17";
			function = "gpio";
		};
		config {
			pins = "gpio16", "gpio17";
			drive-strength = <2>;
			bias-disable;
		};
	};
};

/ {
	i2c_sensors: i2c@24 {
		cell-index = <24>;
		compatible = "i2c-gpio";
		gpios = <&tlmm 64 0 &tlmm 65 0>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		lsm6dsl@6b {
			compatible = "st,lsm6dsl";
			reg = <0x6b>;
			pinctrl-names = "default";
			pinctrl-0 = <&acc_int &sensor_i2c>;
			interrupt-parent = <&tlmm>;
			interrupts = <42 0>;
			st,orientation = <2 1 1 1 2 1 1 1 2>;
			st,drdy-int-pin = <1>;
			st,irq_gpio = <&tlmm 42 0>;
		};

		yas539@2e {
			compatible = "yas_magnetometer";
			reg = <0x2e>;
			yas,orientation = <6>;
			yas,softiron = <0x23f2 0x02 0xfa 0xa7 0x29d5 0x69 0x7b 0x188 0x29a7>;
			yas,softiron_sign = <2 0 0 0 2 0 2 0 2>;
		};
	};

	i2c_prox: i2c@25 {
		cell-index = <25>;
		compatible = "i2c-gpio";
		gpios = <&tlmm 16 0 &tlmm 17 0>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		cm36658@60 {
			compatible = "cm36658";
			reg = <0x60>;
			pinctrl-names = "default";
			pinctrl-0 = <&prox_int &prox_ldo_en &prox_i2c>;
			interrupt-parent = <&tlmm>;
			interrupts = <43 0>;
			cm36658,irq_pin = <&tlmm 43 0>;
			cm36658,led_ldo_pin = <&tlmm 127 0>;
			cm36658,thresh_high = <0x82>;
			cm36658,thresh_low = <0x5a>;
			cm36658,thresh_detect_high = <0xfa0>;
			cm36658,thresh_detect_low = <0x258>;
			cm36658,ps_conf1_reg = <0xc970>;
			cm36658,ps_conf3_reg = <0x8108>;
		};
	};
};
