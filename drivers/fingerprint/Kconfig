menuconfig SENSORS_FINGERPRINT
	bool "Finger Print Sensor devices"
	help
	  Fingerprint sensor drivers (Samsung).

if SENSORS_FINGERPRINT
config SENSORS_FINGERPRINT_32BITS_PLATFORM_ONLY
	bool "Fingerprint sensor supports only 32bits platform"
	default n
config SENSORS_ET5XX
	tristate "ET5XX fingerprint sensor support"
	default n
	help
	  Egistec ET5XX fingerprint sensor.
endif

config SENSORS_FP_SPI_NUMBER
	int "SPI bus number of the TrustZone-owned fingerprint SPI"
	depends on SENSORS_FINGERPRINT
	default 4

config SENSORS_FP_SPI_GPIO_START
	int "First GPIO of the TrustZone-owned fingerprint SPI"
	depends on SENSORS_FINGERPRINT
	default 12

config SENSORS_FP_SPI_GPIO_END
	int "Last GPIO of the TrustZone-owned fingerprint SPI"
	depends on SENSORS_FINGERPRINT
	default 15
